<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cdwater.cdticket.admin.mapper.AdminMapper">

    <select id="selectListAll" resultType="com.cdwater.cdticket.admin.dto.admin.AdminVO">
        SELECT id, username, status, create_time, update_time
        FROM t_admin
        WHERE deleted = 0
        ORDER BY id
    </select>
</mapper>
